# Cloudflare bindings are configured in wrangler.jsonc (D1, R2, Vectorize,
# AI, Workflow, Durable Objects) — no Mongo/Inngest/Voyage anywhere.

# Security hardening (required in production)
# Long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET signs lookup/email-change/ownership tokens
SESSION_SECRET=
# BOOTSTRAP_SECRET locks POST /api/admin/bootstrap
BOOTSTRAP_SECRET=
# BOOTSTRAP_ADMIN_EMAIL pins which account bootstrap may promote (required)
BOOTSTRAP_ADMIN_EMAIL=

# LLM via OpenRouter (OpenAI-compatible). CHEAP_MODEL for summary/depth,
# JUDGE_MODEL for the deep-read judge on top candidates.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CHEAP_MODEL=minimax/minimax-m3:free
JUDGE_MODEL=minimax/minimax-m3:free

# Email (optional — sends degrade to no-ops without these)
RESEND_API_KEY=
RESEND_FROM=Reverse Hiring <onboarding@resend.dev>

# Public site URL used in emailed links
NEXT_PUBLIC_SITE_URL=https://tammy.tammy-app.workers.dev

# R2 presigned uploads (optional — Worker-mediated upload without these)
# Create in Cloudflare dashboard: R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Captcha gate (optional — set to "1" to require a token on profile submit)
# CAPTCHA_REQUIRED=1
